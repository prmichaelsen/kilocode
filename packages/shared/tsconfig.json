{
	"extends": "../config-typescript/base.json",
	"compilerOptions": {
		"outDir": "./dist",
		"rootDir": "./src",
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"strict": true,
		"skipLibCheck": true,
		"moduleResolution": "bundler",
		"target": "ES2022",
		"module": "ESNext",
		"lib": ["ES2022"]
	},
	"include": ["src/**/*"],
	"exclude": [
		"node_modules",
		"dist",
		"**/*.spec.ts",
		"**/*.test.ts",
		"**/__tests__/**"
	]
}