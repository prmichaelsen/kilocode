{
	"extends": "../tsconfig.json",
	"compilerOptions": {
		"outDir": "./dist",
		"rootDir": ".",
		"module": "commonjs",
		"target": "es2020",
		"lib": ["es2020"],
		"moduleResolution": "node",
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"strict": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"baseUrl": ".",
		"paths": {
			"@roo-code/types": ["../../packages/types/src"],
			"@roo-code/cloud": ["../../packages/cloud/src"],
			"@roo-code/telemetry": ["../../packages/telemetry/src"],
			"@src/*": ["../*"],
			"@web/*": ["./*"]
		}
	},
	"include": ["./**/*"],
	"exclude": [
		"../extension.ts",
		"../activate/**/*",
		"./dist/**/*",
		"./client/**/*",
		"**/__tests__/**/*",
		"**/*.test.ts",
		"**/*.spec.ts"
	]
}
